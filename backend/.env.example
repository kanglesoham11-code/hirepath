# ─────────────────────────────────────────────────────────────
# HIREPATH — Environment Variables
# Copy this to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./hirepath.db
# For Docker/PostgreSQL, use:
# DATABASE_URL=postgresql+asyncpg://hirepath:hirepath@localhost:5432/hirepath

# ── Groq (LLM — FREE tier at console.groq.com) ───
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── GitHub (optional, raises rate limit) ─────────
GITHUB_TOKEN=your_github_pat_here
# ── Gmail SMTP ────────────────────────────────────
# Use an App Password (not your account password)
# https://myaccount.google.com/apppasswords
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# ── Google Calendar ───────────────────────────────
# Download credentials.json from Google Cloud Console
# Enable Calendar API → Create OAuth 2.0 credentials
GOOGLE_CREDENTIALS_JSON=credentials.json

# ── Slack ─────────────────────────────────────────
# Incoming Webhook URL from your Slack App
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# ── App ───────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
STALE_THRESHOLD_DAYS=3
