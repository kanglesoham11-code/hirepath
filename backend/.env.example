# ─────────────────────────────────────────────────────────────
# HIREPATH — Environment Variables
# Copy this to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./hirepath.db
# For Docker/PostgreSQL, use:
# DATABASE_URL=postgresql+asyncpg://hirepath:hirepath@localhost:5432/hirepath

# ── Groq (LLM — FREE tier at console.groq.com) ───
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# ── GitHub (REQUIRED — raises rate limit from 60 to 5000/hr) ─
GITHUB_TOKEN=

# ── Gmail SMTP ────────────────────────────────────
# Use an App Password (not your account password)
# https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── Google Calendar ───────────────────────────────
# Download credentials.json from Google Cloud Console
# Enable Calendar API → Create OAuth 2.0 credentials
GOOGLE_CREDENTIALS_JSON=

# ── Slack ─────────────────────────────────────────
# Incoming Webhook URL from your Slack App
SLACK_WEBHOOK_URL=

# ── Auth ──────────────────────────────────────────
# Secret key for API write endpoints. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET_KEY=

# Privacy links sent in outreach expire after this many days.
PRIVACY_TOKEN_TTL_DAYS=30

# ── App ───────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:3000
STALE_THRESHOLD_DAYS=3
