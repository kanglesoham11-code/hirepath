# ─────────────────────────────────────────────────────────────
# HIREPATH v2 — Environment Variables
# Copy to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://hirepath:hirepath@localhost:5432/hirepath

# ── Groq (LLM — FREE at console.groq.com) ────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── GitHub (optional, raises rate limit 60→5000/hr) ──
GITHUB_TOKEN=your_github_pat_here

# ── Gmail SMTP ────────────────────────────────────────
# Create App Password: https://myaccount.google.com/apppasswords
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# ── Google Calendar ───────────────────────────────────
GOOGLE_CREDENTIALS_JSON=credentials.json

# ── Slack alerts ──────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# ── Email Discovery ───────────────────────────────────
# Hunter.io free tier: 25 searches/month → https://hunter.io
HUNTER_API_KEY=your_hunter_api_key_here

# ── Company info (used in outreach personalization) ───
COMPANY_NAME=Your Company
COMPANY_DOMAIN=yourcompany.com

# ── App ───────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
STALE_THRESHOLD_DAYS=3
WEBHOOK_SECRET=change_this_to_random_secret
